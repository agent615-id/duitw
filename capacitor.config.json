{
  "appId": "id.duitw.app",
  "appName": "duitw",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#070b12",
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#070b12",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#070b12",
      "overlaysWebView": true
    }
  }
}
